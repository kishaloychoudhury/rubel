document.addEventListener("DOMContentLoaded",function(){const hamburger=document.querySelector(".hamburger-menu"),overlay=document.querySelector(".mobile-menu-overlay"),closeBtn=document.querySelector(".close-menu"),switcherToggle=document.querySelector(".mobile-section-switcher__toggle"),switcherPanel=document.querySelector(".mobile-section-switcher__panel"),topLevelLinks=document.querySelectorAll("#mobile-primary-site-navigation .menu-item-has-children > a"),logoSlot=document.querySelector(".mobile-overlay-logo-slot"),logoHome=document.querySelector(".mobile-header-inner"),logoEl=document.querySelector(".mobile-logo");function moveLogo(dest){if(logoEl&&dest)dest.prepend(logoEl)}function openOverlay(){moveLogo(logoSlot);overlay.classList.add("active");overlay.removeAttribute("aria-hidden");hamburger.setAttribute("aria-expanded","true");document.body.style.overflow="hidden"}function closeOverlay(){overlay.classList.remove("active");overlay.setAttribute("aria-hidden","true");hamburger.setAttribute("aria-expanded","false");document.body.style.overflow="";collapseAllSubMenus();moveLogo(logoHome);hamburger.focus()}if(hamburger&&overlay)hamburger.addEventListener("click",openOverlay);if(closeBtn&&overlay)closeBtn.addEventListener("click",closeOverlay);document.addEventListener("keydown",function(e){if(e.key==="Escape"&&overlay&&overlay.classList.contains("active"))closeOverlay()});if(switcherToggle&&switcherPanel)switcherToggle.addEventListener("click",function(){const isExpanded=switcherToggle.getAttribute("aria-expanded")==="true";switcherToggle.setAttribute("aria-expanded",String(!isExpanded));switcherPanel.hidden=isExpanded});if(switcherPanel){const mssTopItems=switcherPanel.querySelectorAll(".mobile-section-switcher__list > li.menu-item-has-children");mssTopItems.forEach(function(li){const anchor=li.querySelector(":scope > a"),submenu=li.querySelector(":scope > .sub-menu");if(!anchor||!submenu)return;const label=anchor.textContent.trim(),btn=document.createElement("button");btn.className="mss-accordion-btn";btn.setAttribute("aria-expanded","false");btn.innerHTML=label+'<svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none"><line x1="7" y1="1" x2="7" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="1" y1="7" x2="13" y2="7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';li.insertBefore(btn,anchor);const hasCurrent=li.querySelector(".current-menu-item,.current_page_item,.current-menu-ancestor,.current_page_ancestor");if(hasCurrent){li.classList.add("is-open");btn.setAttribute("aria-expanded","true");}btn.addEventListener("click",function(){const isOpen=li.classList.toggle("is-open");btn.setAttribute("aria-expanded",String(isOpen));mssTopItems.forEach(function(sib){if(sib!==li){sib.classList.remove("is-open");const sibBtn=sib.querySelector(".mss-accordion-btn");if(sibBtn)sibBtn.setAttribute("aria-expanded","false")}})});})}topLevelLinks.forEach(function(link){link.addEventListener("click",function(e){e.preventDefault();const parent=link.closest(".menu-item-has-children"),submenu=parent&&parent.querySelector(":scope > .sub-menu"),isOpen=link.getAttribute("aria-expanded")==="true";collapseSiblings(parent);isOpen?collapseItem(link,submenu):expandItem(link,submenu)})});function expandItem(link,submenu){link.setAttribute("aria-expanded","true");if(submenu)submenu.classList.add("active")}function collapseItem(link,submenu){link.setAttribute("aria-expanded","false");if(submenu)submenu.classList.remove("active")}function collapseSiblings(current){if(!current||!current.parentElement)return;current.parentElement.querySelectorAll(":scope > .menu-item-has-children").forEach(function(sib){if(sib!==current)collapseItem(sib.querySelector("a"),sib.querySelector(":scope > .sub-menu"))})}function collapseAllSubMenus(){topLevelLinks.forEach(function(link){const parent=link.closest(".menu-item-has-children"),submenu=parent&&parent.querySelector(":scope > .sub-menu");collapseItem(link,submenu)})}const admissionsToggle=document.querySelector(".mobile-utility-admissions__toggle"),admissionsList=document.querySelector(".mobile-utility-admissions__list");if(admissionsToggle&&admissionsList)admissionsToggle.addEventListener("click",function(){const isExpanded=admissionsToggle.getAttribute("aria-expanded")==="true";admissionsToggle.setAttribute("aria-expanded",String(!isExpanded));admissionsList.hidden=isExpanded})});
