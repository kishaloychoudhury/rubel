/* ==============================================
   UMBC Stories Block — stories-block.js
   Handles: scroll-entry animation, slider
   (cut transition, dots, touch, keyboard).
   ============================================== */

(function () {
  'use strict';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Scroll-entry observer (slider cards only) ── */
  function initScrollEntry(block) {
    const cards = block.querySelectorAll('.stories-card.will-animate');
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05 }
    );

    cards.forEach((card) => observer.observe(card));
  }

  /* ── Slider ── */
  function initSlider(block) {
    const track   = block.querySelector('.stories-slider__track');
    const dotsWrap = block.querySelector('.stories-slider__dots');
    if (!track) return;

    const cards  = Array.from(track.querySelectorAll('.stories-card'));
    const total  = cards.length;
    let current  = 0;

    function visibleCount() {
      const wrapW = track.parentElement.offsetWidth;
      const cardW = cards[0] ? cards[0].offsetWidth + 16 : 280;
      return Math.max(1, Math.floor(wrapW / cardW));
    }

    function maxIndex() {
      return Math.max(0, total - visibleCount());
    }

    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      const pages = maxIndex() + 1;
      for (let i = 0; i < pages; i++) {
        const dot = document.createElement('button');
        dot.className = 'stories-slider__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
      }
    }

    function goTo(index) {
      current = Math.max(0, Math.min(index, maxIndex()));
      const cardW = cards[0] ? cards[0].offsetWidth + 16 : 280;
      // instant cut — no CSS transition on track
      track.style.transform = 'translateX(-' + (current * cardW) + 'px)';
      updateDots();
      // update aria on cards
      cards.forEach((card, i) => {
        const vis = i >= current && i < current + visibleCount();
        card.setAttribute('aria-hidden', vis ? 'false' : 'true');
      });
    }

    function updateDots() {
      if (!dotsWrap) return;
      const dots = dotsWrap.querySelectorAll('.stories-slider__dot');
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    }

    const prevBtn = block.querySelector('.stories-slider__btn--prev');
    const nextBtn = block.querySelector('.stories-slider__btn--next');

    if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));

    // Keyboard arrows on track
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
    });

    // Touch swipe
    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
    }, { passive: true });

    // Rebuild on resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { buildDots(); goTo(current); }, 120);
    });

    buildDots();
    goTo(0);
  }

  /* ── Expand slider (expand-in-place flex tiles) ── */
  function initExpandSlider(block) {
    const track   = block.querySelector('.stories-expand__track');
    const dotsWrap = block.querySelector('.stories-expand__dots');
    if (!track) return;

    const cards = Array.from(track.querySelectorAll('.stories-expand-card'));
    const total = cards.length;
    if (!total) return;

    let active = cards.findIndex((c) => c.classList.contains('is-active'));
    if (active < 0) active = 0;

    function render() {
      cards.forEach((c, i) => c.classList.toggle('is-active', i === active));
      updateDots();
    }

    function goTo(i) {
      active = ((i % total) + total) % total;
      render();
    }

    function buildDots() {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      for (let i = 0; i < total; i++) {
        const dot = document.createElement('button');
        dot.className = 'stories-expand__dot' + (i === active ? ' is-active' : '');
        dot.type = 'button';
        dot.setAttribute('aria-label', 'Show story ' + (i + 1));
        dot.addEventListener('click', () => goTo(i));
        dotsWrap.appendChild(dot);
      }
    }

    function updateDots() {
      if (!dotsWrap) return;
      dotsWrap.querySelectorAll('.stories-expand__dot').forEach((d, i) => {
        d.classList.toggle('is-active', i === active);
      });
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', (e) => {
        if (i === active) return;
        if (e.target.closest('.stories-expand-card__link')) return;
        goTo(i);
      });
    });

    const prevBtn = block.querySelector('.stories-expand__nav-btn--prev');
    const nextBtn = block.querySelector('.stories-expand__nav-btn--next');
    if (prevBtn) prevBtn.addEventListener('click', () => goTo(active - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goTo(active + 1));

    track.setAttribute('tabindex', '0');
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(active + 1); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(active - 1); }
    });

    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) goTo(dx < 0 ? active + 1 : active - 1);
    }, { passive: true });

    buildDots();
    render();
  }

  /* ── Init all stories blocks on the page ── */
  function initAll() {
    document.querySelectorAll('.umbc-stories-block').forEach((block) => {
      const display = block.dataset.display;
      if (display === 'slider' || display === 'query') {
        initScrollEntry(block);
        initSlider(block);
      } else if (display === 'expand') {
        initExpandSlider(block);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

})();
